# ==============================================================================
# STEAM GUARD RESGATE — ARQUIVO DE EXEMPLO DE VARIÁVEIS DE AMBIENTE (.env.example)
# NUNCA insira credenciais reais neste arquivo.
# Copie este arquivo para .env em ambiente local: cp .env.example .env
# Em produção (Render / Vercel), configure as variáveis diretamente no painel.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AMBIENTE E SERVIDOR
# ------------------------------------------------------------------------------
# Ambiente de execução: development, production, ou test.
# Em 'production', verificações rígidas de segurança são ativadas (chaves fracas são rejeitadas).
APP_ENV=development

# Porta TCP na qual o backend FastAPI deve escutar.
# No Render, esta variável é injetada automaticamente pela plataforma.
PORT=8000

# ------------------------------------------------------------------------------
# 2. BANCO DE DADOS (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Connection string do PostgreSQL.
# Desenvolvimento local (Docker Compose):
#   postgresql://postgres:postgres@localhost:5432/steam_guard_db
# Supabase em Produção:
#   postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# NOTA: O prefixo deve ser postgresql:// (o código normaliza automaticamente postgres:// para postgresql://).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/steam_guard_db

# ------------------------------------------------------------------------------
# 3. SEGURANÇA E CRIPTOGRAFIA
# ------------------------------------------------------------------------------
# Chave secreta para assinatura dos tokens JWT (autenticação administrativa).
# Deve ser uma string criptograficamente segura com no mínimo 32 caracteres em produção.
# Gerar em terminal com: openssl rand -hex 32
JWT_SECRET=super-secret-jwt-key-change-this-in-production-min-32-chars

# Chave mestra de criptografia simétrica para proteger as senhas IMAP no PostgreSQL.
# DEVE ser uma chave Fernet válida (32 bytes codificados em URL-safe base64).
# Gerar em Python: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ATENÇÃO: NUNCA compartilhe nem envie esta chave ao frontend!
MASTER_ENCRYPTION_KEY=VZaokCbhHYZg5M6sslHozPjTZijU5bGgm74kVXE7JB8=

# Tempo de expiração padrão para tokens de resgate gerados (em segundos). Padrão: 3600 (1 hora).
TOKEN_DEFAULT_EXPIRATION=3600

# ------------------------------------------------------------------------------
# 4. CORS E INTEGRAÇÃO FRONTEND
# ------------------------------------------------------------------------------
# Lista de origens permitidas separadas por vírgula para requisições cross-origin (CORS).
# NUNCA utilize '*' em produção com cookies de autenticação!
# Em desenvolvimento: http://localhost:5173,http://localhost:3000
# Em produção: https://seu-frontend.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# URL pública base do Frontend (utilizada para construir links de resgate e redirecionamentos).
# Em desenvolvimento: http://localhost:5173
# Em produção: https://seu-frontend.vercel.app
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 5. PROTOCOLO IMAP (Leitura de e-mails Steam Guard)
# ------------------------------------------------------------------------------
# Timeout máximo em segundos para operações de conexão e busca no servidor IMAP. Padrão: 5
IMAP_TIMEOUT=5

# Intervalo em segundos entre tentativas de busca pelo e-mail com o código Steam Guard. Padrão: 2
CODE_POLL_INTERVAL=2

# Tempo máximo total em segundos que o backend aguardará a chegada do e-mail antes de expirar. Padrão: 15
CODE_POLL_TIMEOUT=15

# ------------------------------------------------------------------------------
# 6. RATE LIMITING E PROTEÇÃO CONTRA ABUSO
# ------------------------------------------------------------------------------
# Limite de requisições padrão (ex: 60/minute).
# O endpoint público de resgate possui limites dedicados por token/sessão (ex: 5/minute).
RATE_LIMIT=60/minute

# ------------------------------------------------------------------------------
# 7. REDIS / CACHE DISTRIBUÍDO (Opcional no MVP)
# ------------------------------------------------------------------------------
# Connection string do Redis (Upstash Redis, Redis Cloud ou instância local).
# Se deixado em branco ou não configurado, o sistema utiliza o mecanismo em memória (In-Memory).
# Exemplo local: redis://localhost:6379/0
# Exemplo Upstash: rediss://default:token@cluster.upstash.io:6379
REDIS_URL=

# ------------------------------------------------------------------------------
# 8. VARIÁVEIS EXCLUSIVAS DO FRONTEND (Vite / Vercel)
# ------------------------------------------------------------------------------
# No Frontend (Vercel ou .env do frontend):
# URL base da API do Backend.
# Desenvolvimento local: http://localhost:8000
# Produção no Render: https://seu-backend.onrender.com
# VITE_API_URL=http://localhost:8000
